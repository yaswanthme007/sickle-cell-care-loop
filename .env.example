# ============================================================================
# Environment Configuration — After the Card (Sickle Cell Care Loop)
# Copy this file to .env.local and fill in your keys
# ============================================================================

# Server-Side Only: Groq API Key (Never prefix with NEXT_PUBLIC_ to prevent browser leak)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional override for Groq model (auto-detects live models via /v1/models if omitted)
GROQ_MODEL="qwen3.6-27b"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
